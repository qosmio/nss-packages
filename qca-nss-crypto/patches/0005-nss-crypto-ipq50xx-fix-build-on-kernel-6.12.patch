From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Subject: [PATCH] nss-crypto: ipq50xx: fix build on kernel 6.12

The kernel 6.12 port fixed the ipq807x HAL but not the ipq50xx one, which
no longer builds with -Wmissing-prototypes (on by default since 6.8):

- nss_crypto_ce5_ctx_fill(), nss_crypto_ce5_engine_init() and
  nss_crypto_ce5_node_init() are only used within nss_crypto_ce5.c; make
  them static.
- nss_crypto_hw.c defines nss_crypto_hw_init()/nss_crypto_hw_deinit()
  without including nss_crypto_hw.h, which declares them, and uses
  of_find_compatible_node() without <linux/of.h>. Include both, as the
  ipq807x HAL does.

diff -ruN a/v2.0/src/hal/ipq50xx/nss_crypto_ce5.c b/v2.0/src/hal/ipq50xx/nss_crypto_ce5.c

Signed-off-by: Andrei-Alexandru Bleortu <me@andrei-z.com>

--- a/v2.0/src/hal/ipq50xx/nss_crypto_ce5.c	2026-09-30 16:31:30.522421654 +0300
+++ b/v2.0/src/hal/ipq50xx/nss_crypto_ce5.c	2026-09-30 16:31:30.534421719 +0300
@@ -232,7 +232,7 @@
  * nss_crypto_ce5_ctx_fill()
  *	Fill context record specific information
  */
-int nss_crypto_ce5_ctx_fill(struct nss_crypto_ctx *ctx, struct nss_crypto_session_data *data,
+static int nss_crypto_ce5_ctx_fill(struct nss_crypto_ctx *ctx, struct nss_crypto_session_data *data,
 				struct nss_crypto_cmn_ctx *msg)
 {
 	struct nss_crypto_ce5_ctx_ctrl *ctx_ctrl;
@@ -268,7 +268,7 @@
  * nss_crypto_ce5_engine_init()
  *	allocate & initialize engine
  */
-int nss_crypto_ce5_engine_init(struct platform_device *pdev, struct resource *crypto_res,
+static int nss_crypto_ce5_engine_init(struct platform_device *pdev, struct resource *crypto_res,
 		struct resource *bam_res, uint8_t eng_id)
 {
 	struct nss_crypto_node *node = platform_get_drvdata(pdev);
@@ -326,7 +326,7 @@
  * nss_crypto_ce5_node_init()
  *	allocate & initialize ce5 node
  */
-int nss_crypto_ce5_node_init(struct platform_device *pdev, const char *name)
+static int nss_crypto_ce5_node_init(struct platform_device *pdev, const char *name)
 {
 	struct device_node *np = of_node_get(pdev->dev.of_node);
 	struct nss_crypto_node *node;
diff -ruN a/v2.0/src/hal/ipq50xx/nss_crypto_hw.c b/v2.0/src/hal/ipq50xx/nss_crypto_hw.c
--- a/v2.0/src/hal/ipq50xx/nss_crypto_hw.c	2024-09-16 10:16:23.000000000 +0300
+++ b/v2.0/src/hal/ipq50xx/nss_crypto_hw.c	2026-09-30 16:31:30.538421741 +0300
@@ -15,8 +15,10 @@
  * PERFORMANCE OF THIS SOFTWARE.
  */
 
+#include <linux/of.h>
 #include <linux/of_platform.h>
 #include "nss_crypto_ce5.h"
+#include "nss_crypto_hw.h"
 
 /*
  * nss_crypto_hw_deinit()
